---
import { MEDIUM_PROFILE } from '../../lib/medium';

const links = [
    {name: "Works", link: "/works/1"},
    {name: "Writing", link: "/#blog"},
    {name: "About", link: "/about"},
]
---

<header class="sticky top-0 z-[1000] border-b-hair border-ek-border bg-ek-bg">
    <div class="max-w-[1180px] mx-auto px-4 tbl:px-8 py-3 flex flex-wrap items-center justify-between gap-3">
        <a href="/" aria-label="Home" class="flex items-center min-h-[44px]">
            <img src="/favicon.svg" width="36" height="33" alt="" />
        </a>
        <nav aria-label="Main" class="flex flex-wrap items-center gap-1">
            {links.map(item => (
                <a href={item.link} class="px-3 py-2.5 rounded text-sm text-ek-text-2 hover:text-ek-text hover:bg-ek-surface-2 transition-colors">
                    {item.name}
                </a>
            ))}
            <a href={MEDIUM_PROFILE} target="_blank" rel="noreferrer" class="ek-btn-primary ml-2 hidden tbl:inline-flex">Follow on Medium</a>
        </nav>
    </div>
</header>
