---
import { MEDIUM_PROFILE } from '../../lib/medium';

const socials = [
    {name: "GitHub", link: "https://github.com/smc181002/"},
    {name: "Medium", link: MEDIUM_PROFILE},
    {name: "X (Twitter)", link: "https://x.com/smc181002"},
    {name: "LinkedIn", link: "https://www.linkedin.com/in/nsmcv18/"},
]
---

<footer class="mt-16 border-t-hair border-ek-border bg-ek-surface-2">
    <div class="max-w-[1180px] mx-auto px-4 tbl:px-8 py-10 flex flex-col gap-8">
        <div class="flex flex-wrap items-end justify-between gap-6">
            <div class="flex flex-col gap-1 max-w-md">
                <p class="ek-eyebrow">Get in touch</p>
                <p class="text-xl tracking-[-0.02em]">Like building things too? Let's work together.</p>
            </div>
            <a href="mailto:meherchaitanya18802@gmail.com" class="ek-btn-outline break-all">meherchaitanya18802@gmail.com</a>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t-hair border-ek-border text-xs text-ek-text-2">
            <span>© {new Date().getFullYear()} smc181002</span>
            <span class="flex flex-wrap gap-x-5 gap-y-2">
                {socials.map(item => (
                    <a href={item.link} target="_blank" rel="noreferrer" class="flex items-center gap-1 hover:text-ek-text transition-colors">
                        {item.name}<span class="material-symbols-rounded text-sm" aria-hidden="true">arrow_outward</span>
                    </a>
                ))}
            </span>
        </div>
    </div>
</footer>
