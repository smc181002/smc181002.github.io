---
import { getMediumPosts, MEDIUM_PROFILE } from '../../lib/medium';

const { limit = 3 } = Astro.props;
const posts = await getMediumPosts(limit);
const formatDate = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<section id="blog" aria-labelledby="blog-title" class="flex flex-col gap-5 scroll-mt-24">
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="flex flex-col gap-1">
            <p class="ek-eyebrow">Latest from Medium</p>
            <h2 id="blog-title" class="ek-title">Writing</h2>
            <p class="text-sm text-ek-text-2">Notes and write-ups on what I build and learn</p>
        </div>
        <a href={MEDIUM_PROFILE} target="_blank" rel="noreferrer" class="ek-btn-outline">
            All posts on Medium
            <span class="material-symbols-rounded text-base" aria-hidden="true">arrow_outward</span>
        </a>
    </div>

    {posts.length > 0 ? (
        <div class="flex flex-wrap gap-4">
            {posts.map((post) => (
                <a href={post.link} target="_blank" rel="noreferrer" class="ek-card hover:border-ek-border-strong flex-[1_1_300px] min-w-0 flex flex-col gap-3.5 p-5 text-ek-text">
                    <span class="flex items-center justify-between gap-2 text-xs text-ek-text-2 ek-num">
                        <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
                        <span>{post.readMinutes} min read</span>
                    </span>
                    <span class="text-xl font-medium tracking-[-0.02em]">{post.title}</span>
                    {post.excerpt && <span class="text-sm text-ek-text-2">{post.excerpt}</span>}
                    <span class="mt-auto pt-3.5 border-t-hair border-ek-border flex items-center justify-between gap-2">
                        <span class="flex flex-wrap gap-1.5">
                            {post.tags.map((t) => <span class="ek-chip">{t}</span>)}
                        </span>
                        <span class="flex items-center gap-1 text-sm font-medium">
                            Read <span class="material-symbols-rounded text-base" aria-hidden="true">arrow_outward</span>
                        </span>
                    </span>
                </a>
            ))}
        </div>
    ) : (
        <div class="ek-card p-5 text-sm text-ek-text-2">
            Posts couldn't be loaded right now. Read them on <a href={MEDIUM_PROFILE} class="underline text-ek-text">Medium</a>.
        </div>
    )}
</section>
