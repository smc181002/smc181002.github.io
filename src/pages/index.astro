---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content';
import WorkItem from '../components/works/WorkItem.svelte';
import MediumPosts from '../components/blog/MediumPosts.astro';
import Experience from '../components/about/Experience.astro';
import BrandIcon from '../components/icons/BrandIcon.astro';
import { certifications } from '../lib/certifications';

const works = await getCollection('works')
const sortedWorks = works.sort((a,b) => {
    let c = new Date(a.data.date)
    let d = new Date(b.data.date)

    return c<d ? 1 : -1;
}).slice(0,3);


---

<BaseLayout>
    <main class="max-w-[1180px] mx-auto px-4 tbl:px-8 pt-7 flex flex-col gap-14">
        <section aria-labelledby="hero-title" class="bg-ek-accent text-ek-accent-ink rounded-none px-6 tbl:px-10 pt-10 tbl:pt-12 pb-9 flex flex-col gap-7">
            <p class="text-xs font-medium tracking-[0.02em] text-ek-hero-muted">
                Software engineer · <a href="https://www.gevernova.com" target="_blank" rel="noreferrer" class="underline underline-offset-2 hover:text-ek-accent-ink">GE Vernova</a>
            </p>
            <h1 id="hero-title" class="max-w-[920px] text-4xl lpt:text-[56px] leading-[1.06] font-normal tracking-[-0.045em]">
                I experiment with new ideas and turn them into working software.
            </h1>
            <p class="max-w-[680px] text-[17px] leading-[26px] text-ek-hero-muted">
                A software engineer who likes taking ideas from a sketch to something that ships. Lately that means working close to the wire, with a conceptual grounding in how substation networks and their protocols fit together.
            </p>
            <div class="border-t-hair border-ek-hero-rule pt-5 flex flex-wrap gap-x-12 gap-y-6">
                {certifications.map(cert => (
                    <a href={cert.link} target="_blank" rel="noreferrer" class="group flex items-center gap-3">
                        <BrandIcon name={cert.icon} size={22}/>
                        <span class="flex flex-col gap-0.5">
                            <span class="text-xs text-ek-hero-muted">Certified · Credly</span>
                            <span class="font-medium group-hover:underline underline-offset-2">{cert.short}</span>
                        </span>
                    </a>
                ))}
                <div class="flex flex-col gap-0.5">
                    <span class="text-xs text-ek-hero-muted">Currently exploring</span>
                    <span class="font-medium">Substation network protocols</span>
                </div>
            </div>
        </section>

        <section id="works" aria-labelledby="works-title" class="flex flex-col gap-5 scroll-mt-24">
            <div class="flex flex-wrap items-end justify-between gap-3">
                <div class="flex flex-col gap-1">
                    <p class="ek-eyebrow">Learning from doing</p>
                    <h2 id="works-title" class="ek-title">Works</h2>
                </div>
                <a href="/works/1" class="ek-btn-outline">
                    View all works
                    <span class="material-symbols-rounded text-base" aria-hidden="true">arrow_forward</span>
                </a>
            </div>
            <div class="ek-card">
                {sortedWorks.map((work) => <WorkItem item={work}/>)}
            </div>
        </section>

        <MediumPosts limit={3}/>

        <Experience/>
    </main>
</BaseLayout>
