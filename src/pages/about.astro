---
import BaseLayout from '../layouts/BaseLayout.astro'
import Experience from '../components/about/Experience.astro';
import BrandIcon from '../components/icons/BrandIcon.astro';
import { certifications } from '../lib/certifications';
---

<BaseLayout title="About">
    <main class="max-w-[1180px] mx-auto px-4 tbl:px-8 pt-7 flex flex-col gap-14">
        <section class="flex flex-col gap-3 max-w-3xl">
            <p class="ek-eyebrow">About</p>
            <h1 class="ek-title">Hi, I'm Meher Chaitanya</h1>
            <p class="text-lg text-ek-text-2">
                I'm a software engineer at <a href="https://gevernova.com" target="_blank" rel="noreferrer" class="text-ek-text underline underline-offset-2">GE Vernova</a>,
                building software end to end. Lately I work close to the network, with a conceptual
                grounding in how substation networks and their protocols fit together.
            </p>
        </section>

        <Experience/>

        <section aria-labelledby="certs-title" class="flex flex-col gap-5">
            <h2 id="certs-title" class="ek-title">Certifications</h2>
            <div class="ek-card">
                {certifications.map(cert => (
                    <a href={cert.link} target="_blank" rel="noreferrer" class="flex flex-wrap items-center gap-x-4 gap-y-2 px-5 py-[18px] border-b-hair border-ek-border last:border-b-0 hover:bg-ek-hover transition-colors">
                        <span class="w-9 h-9 rounded border-hair border-ek-border flex items-center justify-center text-ek-text"><BrandIcon name={cert.icon} size={20}/></span>
                        <span class="flex-[999_1_240px] font-medium">{cert.name}</span>
                        <span class="ek-chip">{cert.code} · Credly <span class="material-symbols-rounded text-sm" aria-hidden="true">arrow_outward</span></span>
                    </a>
                ))}
            </div>
        </section>
    </main>
</BaseLayout>
