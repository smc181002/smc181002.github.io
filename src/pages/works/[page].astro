---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content';
import WorkItem from '../../components/works/WorkItem.svelte'

export async function getStaticPaths({ paginate }) {
    const works = await getCollection('works');
    const sortedWorks = works.sort((a,b) => {
        let c = new Date(a.data.date)
        let d = new Date(b.data.date)

        return c<d ? 1 : -1;
    });
    return paginate(sortedWorks, { pageSize: 10 });
}

const {page} = Astro.props;
---

<BaseLayout title="Works">
    <main class="max-w-[1180px] mx-auto px-4 tbl:px-8 pt-7">
        <section id="works" class="flex flex-col gap-5">
            <div class="flex flex-col gap-1">
                <p class="ek-eyebrow">Learning from doing</p>
                <h1 class="ek-title">Works</h1>
                <p class="text-sm text-ek-text-2">Projects, tools and write-ups, newest first</p>
            </div>
            <div class="ek-card">
                {page.data.map((work) => <WorkItem item={work}/>)}
            </div>
            <nav aria-label="Pagination" class="flex items-center gap-2">
                {page.url.prev
                    ? <a href={page.url.prev} class="ek-btn-outline"><span class="material-symbols-rounded text-base" aria-hidden="true">arrow_back</span>Previous</a>
                    : <span class="ek-btn border-hair border-ek-border text-ek-text-3" aria-disabled="true"><span class="material-symbols-rounded text-base" aria-hidden="true">arrow_back</span>Previous</span>}
                {page.url.next
                    ? <a href={page.url.next} class="ek-btn-outline">Next<span class="material-symbols-rounded text-base" aria-hidden="true">arrow_forward</span></a>
                    : <span class="ek-btn border-hair border-ek-border text-ek-text-3" aria-disabled="true">Next<span class="material-symbols-rounded text-base" aria-hidden="true">arrow_forward</span></span>}
            </nav>
        </section>
    </main>
</BaseLayout>
